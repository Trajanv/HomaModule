<mxfile host="Electron" agent="Copilot">
  <diagram id="ack-retention" name="ACK retention before and after">
    <mxGraphModel dx="1533" dy="903" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#172B4D;" value="Homa server ACK retention: before and after" vertex="1">
          <mxGeometry height="44" width="1200" x="40" y="24" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#526581;" value="Bug fix: completed server responses honor the existing silence timeout. No new configuration parameter." vertex="1">
          <mxGeometry height="28" width="1200" x="42" y="68" as="geometry" />
        </mxCell>
        <mxCell id="beforePanel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#B8C7D9;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="755" width="735" x="35" y="120" as="geometry" />
        </mxCell>
        <mxCell id="afterPanel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF7;strokeColor=#92CDB5;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="755" width="770" x="795" y="120" as="geometry" />
        </mxCell>
        <mxCell id="beforeTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#8BA6C1;fontColor=#19324D;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="BEFORE / TIMEOUT BYPASSED" vertex="1">
          <mxGeometry height="48" width="695" x="55" y="138" as="geometry" />
        </mxCell>
        <mxCell id="afterTitle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F0E4;strokeColor=#79B99A;fontColor=#164B36;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" value="AFTER / EXISTING TIMEOUT RESTORED" vertex="1">
          <mxGeometry height="48" width="730" x="815" y="138" as="geometry" />
        </mxCell>
        <mxCell id="beforeDefault" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D6A943;fontColor=#664B00;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="Server resets silent_ticks and returns before the timeout check." vertex="1">
          <mxGeometry height="40" width="625" x="90" y="198" as="geometry" />
        </mxCell>
        <mxCell id="afterConfig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EC;strokeColor=#79B99A;fontColor=#164B36;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="Existing defaults: request_ack_ticks = 2; timeout_ticks = 100 (~100 ms)." vertex="1">
          <mxGeometry height="40" width="660" x="850" y="198" as="geometry" />
        </mxCell>
        <mxCell id="beforeStep1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#19324D;fontSize=15;spacing=10;" value="1  Response fully transmitted&lt;br&gt;&lt;b&gt;Server keeps RPC + response data&lt;/b&gt;" vertex="1">
          <mxGeometry height="72" width="605" x="100" y="265" as="geometry" />
        </mxCell>
        <mxCell id="beforeStep2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#19324D;fontSize=14;spacing=10;" value="2  No ACK received&lt;br&gt;After request_ack_ticks (default 2 ticks ≈ 2 ms), server sends NEED_ACK on every timer tick." vertex="1">
          <mxGeometry height="88" width="605" x="100" y="372" as="geometry" />
        </mxCell>
        <mxCell id="beforeStep3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#D97A70;fontColor=#6F2923;fontSize=14;spacing=10;" value="3  ACK still cannot arrive&lt;br&gt;&lt;b&gt;Retained RPC and response persist; NEED_ACK repeats.&lt;/b&gt;&lt;br&gt;timeout_ticks does not expire this completed server RPC." vertex="1">
          <mxGeometry height="96" width="605" x="100" y="495" as="geometry" />
        </mxCell>
        <mxCell id="beforeImpact" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE2DF;strokeColor=#D97A70;fontColor=#6F2923;fontSize=14;align=center;verticalAlign=middle;spacing=9;" value="LIVE BASELINE: NO FEEDBACK&lt;br&gt;&lt;b&gt;794 captured NEED_ACKs; last saved at ~810 ms.&lt;/b&gt;&lt;br&gt;Kernel trace: still requesting ACK at elapsed tick 1,174.&lt;br&gt;No silence timeout before test-server shutdown." vertex="1">
          <mxGeometry height="108" width="605" x="100" y="655" as="geometry" />
        </mxCell>
        <mxCell id="beforeLoop" edge="1" parent="1" source="beforeStep3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C4554D;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#8C342D;labelBackgroundColor=#F4F7FB;" target="beforeStep2" value="ACK&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; absent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="beforeDown1" edge="1" parent="1" source="beforeStep1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;endFill=1;" target="beforeStep2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="beforeDown2" edge="1" parent="1" source="beforeStep2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;endFill=1;" target="beforeStep3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="beforeDown3" edge="1" parent="1" source="beforeStep3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;endFill=1;" target="beforeImpact" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="afterStep1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#45A77B;fontColor=#164B36;fontSize=15;spacing=10;" value="1  Response fully transmitted&lt;br&gt;&lt;b&gt;Server now checks the ordinary silence timeout.&lt;/b&gt;" vertex="1">
          <mxGeometry height="72" width="610" x="875" y="265" as="geometry" />
        </mxCell>
        <mxCell id="afterStep2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#45A77B;fontColor=#164B36;fontSize=14;spacing=10;" value="2  ACK absent: NEED_ACK repeats after request_ack_ticks.&lt;br&gt;Outgoing NEED_ACK does not reset silence.&lt;br&gt;Client RESEND feedback resets it; server does not request RESEND." vertex="1">
          <mxGeometry height="88" width="610" x="875" y="372" as="geometry" />
        </mxCell>
        <mxCell id="afterStep3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#45A77B;fontColor=#164B36;fontSize=14;spacing=10;" value="3  ACK arrives before timeout&lt;br&gt;Normal ACK path ends the RPC and allows response data to be reaped." vertex="1">
          <mxGeometry height="78" width="610" x="875" y="495" as="geometry" />
        </mxCell>
        <mxCell id="afterStep4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EC;strokeColor=#45A77B;fontColor=#164B36;fontSize=14;spacing=10;" value="OR: silent_ticks reaches timeout_ticks&lt;br&gt;&lt;b&gt;Ordinary timeout aborts RPC; response buffers enter normal reaping.&lt;/b&gt;" vertex="1">
          <mxGeometry height="78" width="610" x="875" y="595" as="geometry" />
        </mxCell>
        <mxCell id="afterCaveat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D6A943;fontColor=#664B00;fontSize=13;align=left;verticalAlign=middle;spacing=10;" value="LIVE FIX: 98 captured NEED_ACKs; last at ~102 ms.&lt;br&gt;Trace confirms normal timeout and -ETIMEDOUT abort.&lt;br&gt;&lt;br&gt;&lt;b&gt;Silence timeout, not an absolute deadline:&lt;/b&gt; client feedback postpones expiry. Once state is discarded, response recovery and duplicate suppression end.&lt;br&gt;No new configuration; no ack_timeout_ticks." vertex="1">
          <mxGeometry height="132" width="610" x="875" y="700" as="geometry" />
        </mxCell>
        <mxCell id="afterDown1" edge="1" parent="1" source="afterStep1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#45A77B;strokeWidth=2;endArrow=block;endFill=1;" target="afterStep2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="afterAck" edge="1" parent="1" source="afterStep2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#318A62;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#216546;labelBackgroundColor=#F2FAF7;" target="afterStep3" value="ACK received">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="afterExpiry" edge="1" parent="1" source="afterStep2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D29A26;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#795800;labelBackgroundColor=#F2FAF7;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" target="afterStep4" value="No feedback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="afterNoteEdge" edge="1" parent="1" source="afterStep4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D6A943;strokeWidth=1.5;dashed=1;endArrow=none;" target="afterCaveat" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#526581;" value="Live test: ACKs and relevant ICMP errors blocked for one test flow; no host crashed. Counts are saved packets, not exact transmit totals. Explicit peer/network errors can also clean up RPCs." vertex="1">
          <mxGeometry height="34" width="1500" x="45" y="886" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
